# shortly 환경설정 예시. 이 파일을 .env 로 복사해서 값을 채우세요.
# 값이 없으면 해당 기능은 자동으로 비활성/대체됩니다.

# ===== 제품 프로파일 =====
# 비우면 기존 개발 동작(legacy)을 유지합니다.
# 팀/개인 전용 launcher가 각각 team/personal 값을 고정하므로 일반 사용자는 수정하지 않습니다.
# SHORTLY_PRODUCT=legacy

# ===== LLM/비전 제공자 =====
# 지원: gemini | openai | anthropic | local | none
#   local = Ollama / LM Studio / llama.cpp 등 OpenAI 호환 로컬 서버
SHORTLY_LLM_PROVIDER=gemini

# 각 제공자 API 키(사용하는 것만 채우면 됩니다)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 로컬 서버(provider=local 일 때). Ollama 기본 11434, LM Studio 기본 1234.
SHORTLY_LOCAL_BASE_URL=http://localhost:11434/v1
SHORTLY_LOCAL_API_KEY=ollama

# 모델명(비워두면 제공자별 기본값 사용)
#   로컬 예: Ollama 는 "qwen3.6:27b", LM Studio 는 로드한 모델 id
SHORTLY_TEXT_MODEL=
SHORTLY_VISION_MODEL=

# ===== 가이드/대본 '생성' 전용 모델(선택) =====
# 영상 분석은 위 모델로, '대본 생성'만 고품질 상용 모델로 분리하고 싶을 때 사용.
# 비우면 위 분석 모델(SHORTLY_LLM_PROVIDER)을 그대로 씁니다.
# 예) 분석=로컬 Qwen, 생성=Claude Opus:
#   SHORTLY_GEN_PROVIDER=anthropic
#   SHORTLY_GEN_MODEL=claude-opus-4-8
SHORTLY_GEN_PROVIDER=
SHORTLY_GEN_MODEL=

# ===== TTS(선택) =====
# Typecast 신규 API. 키 발급: https://typecast.ai/developers/api/api-key
# 이 키가 있으면 캡컷 내보내기 시 자막 단위로 음성을 생성하고, 그 길이의 합이
# 영상 길이가 됩니다(키가 없으면 TTS 없이 텍스트 길이 기반으로 배치).
TYPECAST_API_KEY=
# 기본값: 캐릭터 '지훈', 1.3배속, toneup 100% (필요 시만 아래를 채워 재정의)
SHORTLY_TTS_VOICE_ID=tc_61f0859907085fc68561c9a1
SHORTLY_TTS_TEMPO=1.3
SHORTLY_TTS_EMOTION=toneup
# TTS 음성 파일 저장 위치. 비우면 제품별 사용자 파일 폴더 아래 tts/를 사용합니다.
SHORTLY_TTS_OUTPUT_DIR=
# 캡컷 내보내기 시 복사·활용할 템플릿 프로젝트명
SHORTLY_CAPCUT_TEMPLATE=챙맛 템플릿

# ===== 경로 =====
# 분석 결과/캐시 저장 위치(기본: 프로젝트 내 data/)
SHORTLY_DATA_DIR=
# 사용자 결과물과 로그 위치(비우면 제품별 Windows Documents 폴더)
SHORTLY_ARTIFACT_DIR=
SHORTLY_LOG_DIR=
# 참조 효과음 라이브러리 폴더(팀 프로파일에서는 비활성)
SHORTLY_SFX_DIR=

# ===== 수집 옵션 =====
# 채널당 학습에 사용할 최대 쇼츠 개수
SHORTLY_MAX_SHORTS=30

# ===== 웹 서버 =====
# 0.0.0.0 = 같은 공유기(LAN)의 다른 PC에서도 접속 가능(연산은 이 PC에서 수행).
# 이 PC에서만 쓰려면 127.0.0.1 로 바꾸세요.
SHORTLY_HOST=0.0.0.0
SHORTLY_PORT=8756
# 1 = 사설망(LAN)에서만 접속 허용, 외부(공인) IP 차단. 0 이면 제한 해제.
SHORTLY_LAN_ONLY=1

# ===== 대본 웹 조사 =====
# 주제 모드에서 웹 검색으로 팩트/각도를 보강합니다(1=켜짐).
SHORTLY_RESEARCH=1
SHORTLY_RESEARCH_MAX_RESULTS=8
SHORTLY_RESEARCH_MAX_QUERIES=5
# 대본 생성 후 시점·주체 최종 팩트체크(1=켜짐).
SHORTLY_FACTCHECK=1

# ===== 팀용 포터블 =====
# 1 이면 학습=claude-sonnet-5, 생성=claude-opus-4-8 고정 + 효과음 OFF.
# 팀 launcher는 SHORTLY_PRODUCT=team과 이 값을 자동으로 설정합니다.
# SHORTLY_PORTABLE=0
